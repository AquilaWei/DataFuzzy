# Clean test environment. Built for linux/arm64 by tools/test_arm64.sh to mimic
# Apple Silicon's CPU architecture (macOS itself can't run in a container).
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
        libegl1 libgl1 libxkbcommon0 libfontconfig1 libglib2.0-0 libdbus-1-3 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_LINK_MODE=copy QT_QPA_PLATFORM=offscreen
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src
RUN uv sync --frozen
COPY tests ./tests
CMD ["uv", "run", "pytest"]
