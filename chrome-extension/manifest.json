{
  "manifest_version": 3,
  "name": "TheraNote ACE Filler",
  "version": "0.7.0.37",
  "version_name": "0.7.0.37.5",
  "description": "Fills ACE Portal time entries from a TheraNote ACE fill-in file, one cell at a time, for you to check and save.",
  "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"},
  "action": {
    "default_title": "TheraNote → ACE",
    "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}
  },
  "permissions": ["storage"],
  "host_permissions": ["https://www.acestudentcare.com/*", "https://acestudentcare.com/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["https://www.acestudentcare.com/*", "https://acestudentcare.com/*"],
      "js": ["page.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.acestudentcare.com/*", "https://acestudentcare.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
